    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a Student Data Cleaning Assistant.\n\nAnalyze the following student enrollment record.\n\nTasks:\n1. Clean unnecessary spaces from Student_ID, Name, Email, Course and City.\n2. Convert Email to lowercase.\n3. Standardize City name as Chennai when it refers to Chennai.\n4. Preserve Phone, Fee_Paid and Enrolled_Date.\n5. Do not invent or modify student information.\n6. Do not decide whether the email is valid or filter records. JavaScript will perform final validation.\n\nReturn ONLY valid JSON with these fields:\nStudent_ID, Name, Email, Phone, Course, Fee_Paid, City, Enrolled_Date.\n\nStudent Record:\n{{ JSON.stringify($json) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
